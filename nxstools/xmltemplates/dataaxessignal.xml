<?xml version='1.0'?>
<definition>
  <attribute type="NX_CHAR" name="default">$var.entryname#'$(__entryname__)'$var.serialno</attribute>
  <group type="NXentry" name="$var.entryname#'$(__entryname__)'$var.serialno">
    <attribute type="NX_CHAR" name="default">data</attribute>
    <group type="NXdata" name="data">
          <attribute type="NX_CHAR" name="signal">
            <strategy mode="FINAL"/>$datasources.$(signal)
	  </attribute>
          <attribute type="NX_CHAR" name="axes">
            <strategy mode="FINAL"/>$datasources.$(axes)
	    <dimensions rank="1">
                  <dim value="0" index="1"/>
	    </dimensions>
	  </attribute>
    </group>
  </group>
  <doc>
    signalname datasource depends on $var.detector
  </doc>
</definition>
